# Keep the Docker build context small and free of local secrets.
# Without this file `docker build` uploads the entire working tree to the
# daemon (frontend/node_modules ~259M, backend/.venv ~156M, .git, and any
# gitignored .env with real PAPERLESS_API_TOKEN / LLM keys), and bakes the
# local node_modules into the frontend build stage on top of `npm ci`.
# The image only needs frontend/, backend/, docker/, and VERSION.

# VCS
.git
.gitignore
.github
.gitea

# Local environment / session (real secrets)
.env
.env.*
.session*

# Python build artifacts
__pycache__/
*.pyc
backend/.venv
.pytest_cache
.ruff_cache

# Node build artifacts (installed by `npm ci` in the frontend stage)
frontend/node_modules

# Local data and caches
data/
tmp
coverage
coverage/

# Docs and editor noise (not needed in the image)
docs
.idea
